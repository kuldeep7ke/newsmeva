#!/bin/sh
# NEWS MEVA Online - Debian/Ubuntu package post-remove
set -e

case "$1" in
  purge)
    # "apt purge": remove everything including user data.
    systemctl stop newsmeva.service newsmeva-caddy.service 2>/dev/null || true
    systemctl disable newsmeva.service newsmeva-caddy.service 2>/dev/null || true
    rm -rf /opt/newsmeva
    rm -rf /opt/newsmeva-node
    if id -u meva >/dev/null 2>&1; then userdel meva 2>/dev/null || true; fi
    systemctl daemon-reload 2>/dev/null || true
    ;;
  remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    # "apt remove": keep /opt/newsmeva (data + .env) so reinstall restores it.
    ;;
esac
exit 0