# NEWS MEVA - backend environment (copy to backend/.env and fill in)
# Copy:  copy .env.example .env   (Windows)  /  cp .env.example .env (Mac/Linux)
# NOTE: .env is git-ignored - never commit it.

# PostgreSQL connection string from Supabase (Project Settings -> Database)
# Format:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# JWT secret for authentication tokens (generate a random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string

# Server port
PORT=3003

# Node environment
NODE_ENV=production

# Optional: install-monitor push target. Leave empty to disable the monitor.
# Never commit a filled-in value; see docs/MEMORY-CAPSULE.md (security notes).
MONITOR_DATABASE_URL=
# Developer login for first boot (optional). If unset, a random password is
# generated for this install and printed to the server console exactly once.
DEV_ADMIN_PASSWORD=