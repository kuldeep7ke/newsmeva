# Windows installer binary (rebuilt on demand — keep the NSIS script in git)
installer/*.exe

# Debian/Ubuntu installer binary (rebuilt on demand — keep the build script in git)
installer/*.deb

# Bundled Node.js runtime for the installer (zip + extracted = regenerable download)
tools/node/*.zip
tools/node/*.msi
tools/node/*.pkg
tools/node/node-v24.19.0-win-x64/

# Bundled Caddy for the .deb installer (downloads at build time)
tools/caddy/

# Android build artifacts
android/app/build/
android/.gradle/
android/local.properties
*.tar.xz
*.tar.gz
# Bundled server/frontend assets for the APK (copied from backend/dist, node_modules, frontend/dist at build time)
android/app/src/main/assets/server/
android/app/src/main/assets/frontend/
# Node runtimes for Android APK (gradle downloads at build time if absent;
# keep local copies in app/src/main/assets/node/bin to build offline)
android/app/src/main/assets/node/

